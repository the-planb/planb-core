{
  "git": {
    "commitMessage": "chore(release): v${version}\n\n[skip ci]",
    "commitArgs": ["--no-verify"],
    "push": true,
    "tagName": "v${version}",
    "tag": true
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": {
        "name": "conventionalcommits"
      }
    }
  }
}
